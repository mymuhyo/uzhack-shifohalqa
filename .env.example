# ShifoHalqa — environment shabloni (.env.local ga nusxalang; gitignored)

# Neon Postgres (project: shifohalqa). Codex lane: codex-dev branch URL.
DATABASE_URL="postgresql://...-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://...ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Demo sessiya HMAC kaliti (openssl rand -hex 32)
SESSION_SECRET=""

# DoriMos. Cloudflare bo‘lsa Clef + Clairic tanlanadi. `gemini` Gemini Decisions + OpenRouter yo‘lini tanlaydi.
DORIMOS_PROVIDER="auto"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_DECISION_MODEL="@cf/cloudflare/clef"
CLOUDFLARE_EXTRACTION_MODEL="@cf/cloudflare/clairic-flash"

# Gemini Decisions (DoriMos zaxira sifat tekshiruvi)
GEMINI_API_KEY=""
GEMINI_DECISION_MODEL="gemini-decision-1"

# OpenRouter (DoriMos OCR, video namuna va Baidu izohi)
OPENROUTER_API_KEY=""
OPENROUTER_OCR_MODEL="nvidia/nemotron-3.5-super-vl:free"
OPENROUTER_OCR_FALLBACK_MODEL="google/gemma-4-26b-a4b-it:free"
EXERCISE_OPENROUTER_DEMO="false"
OPENROUTER_EXERCISE_MODEL="nvidia/nemotron-3.5-super-vl:free"

# Veb-ilovaga faqat bot nomi kerak (@ belgisiz). Qolgan qiymatlar Python servisiga beriladi.
TELEGRAM_BOT_USERNAME=""
TELEGRAM_BOT_TOKEN=""
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_APP_URL=""
TELEGRAM_WEBHOOK_URL=""
# Ixtiyoriy. Shu demo bazasining Postgres URL'i. Bo‘sh bo‘lsa DATABASE_URL ishlatiladi.
TELEGRAM_DATABASE_URL=""
TELEGRAM_HOST="127.0.0.1"
TELEGRAM_PORT="3420"

# App
NEXT_PUBLIC_APP_URL=""
DEMO_MODE="true"
DEMO_ANDROID_ENABLED="false"
