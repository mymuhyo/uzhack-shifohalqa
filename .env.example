# ShifoHalqa — environment shabloni (.env.local ga nusxalang; gitignored)

# Supabase (`shifohalqa-final`, project ref: byswnhfcqxjvnallggxj, ap-southeast-1)
NEXT_PUBLIC_SUPABASE_URL="https://byswnhfcqxjvnallggxj.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Postgres ulanishlari (Supavisor pooler + unpooled migration/psql)
DATABASE_URL="postgresql://postgres.byswnhfcqxjvnallggxj:...@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres:...@db.byswnhfcqxjvnallggxj.supabase.co:5432/postgres"

# Muhit identifikatori (public.environment_identity.env_id bilan mos bo‘lishi shart)
SHIFO_ENV_ID="final-preview"

# Demo sessiya HMAC kaliti (openssl rand -hex 32)
SESSION_SECRET=""

# Auth: ommaviy ro‘yxatdan o‘tish demo/preview muhitda yopiq (faqat oldindan seed qilingan klinika hisoblari)
AUTH_SIGNUP_ENABLED="false"

# DoriMos. Cloudflare bo‘lsa Clef + Clairic tanlanadi. `gemini` Gemini Decisions va tanlangan OCR provayderini ishlatadi.
DORIMOS_PROVIDER="auto"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_DECISION_MODEL="@cf/cloudflare/clef"
CLOUDFLARE_EXTRACTION_MODEL="@cf/cloudflare/clairic-flash"

# Gemini Decisions (DoriMos zaxira sifat tekshiruvi)
GEMINI_API_KEY=""
GEMINI_DECISION_MODEL="gemini-decision-1"

# `auto` rejimi Vercel AI Gateway → Cloudflare Workers AI → deterministik zaxira tartibidan foydalanadi.
AI_COMPLETION_PROVIDER="auto"
AI_GATEWAY_API_KEY=""
# Ixtiyoriy model nomlari (sukut: openai/gpt-oss-20b, alibaba/qwen3.6-35b-a3b, @cf/meta/llama-3.3-70b-instruct-fp8-fast, @cf/meta/llama-3.2-11b-vision-instruct)
# VERCEL_AI_TEXT_MODEL=""
# VERCEL_AI_VISION_MODEL=""
# CLOUDFLARE_TEXT_MODEL=""
# CLOUDFLARE_VISION_MODEL=""
OPENCODE_GO_API_KEY=""
OPENCODE_API_KEY=""
EXERCISE_AI_DEMO="false"
EXERCISE_COACH_AI_DEMO="false"
EXERCISE_OPENCODE_DEMO="false"
EXERCISE_COACH_OPENCODE_DEMO="false"

# OpenRouter (ixtiyoriy zaxira / namuna)
OPENROUTER_API_KEY=""
OPENROUTER_OCR_MODEL="nvidia/nemotron-3.5-super-vl:free"
OPENROUTER_OCR_FALLBACK_MODEL="google/gemma-4-26b-a4b-it:free"
EXERCISE_OPENROUTER_DEMO="false"
EXERCISE_COACH_OPENROUTER_DEMO="false"
OPENROUTER_EXERCISE_MODEL="nvidia/nemotron-3.5-super-vl:free"

# Veb-ilovaga faqat bot nomi kerak (@ belgisiz). Qolgan qiymatlar Python va Next.js servislari o‘rtasida ulashiladi.
TELEGRAM_BOT_USERNAME=""
TELEGRAM_BOT_TOKEN=""
# openssl rand -hex 32 (>= 32 belgi)
TELEGRAM_WEBHOOK_SECRET=""
# Bot <-> Next.js /api/telegram/bridge ichki xizmat siri (openssl rand -hex 32, >= 32 belgi)
TELEGRAM_BOT_SERVICE_SECRET=""
TELEGRAM_APP_URL=""
TELEGRAM_WEBHOOK_URL=""
# Ixtiyoriy: Python bot Next.js API ni qaysi bazaviy URL orqali chaqirishi (sukut: TELEGRAM_APP_URL)
TELEGRAM_API_BASE_URL=""
# Ixtiyoriy. Shu preview bazasining Postgres URL'i. Bo‘sh bo‘lsa DATABASE_URL ishlatiladi.
TELEGRAM_DATABASE_URL=""
TELEGRAM_HOST="127.0.0.1"
TELEGRAM_PORT="3420"

# App
NEXT_PUBLIC_APP_URL=""
DEMO_MODE="true"
DEMO_ANDROID_ENABLED="false"
